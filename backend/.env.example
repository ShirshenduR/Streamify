# Django settings
#
# Either name works — both are read, so you never have to rename an existing
# secret. Required when DEBUG is off; a development key is used when DEBUG is on.
DJANGO_SECRET_KEY=your-django-secret-key
# SECRET_KEY=your-django-secret-key

# Debug is parsed as a real boolean now, so "False" actually turns it off.
DEBUG=True

# Database. Optional locally (SQLite is the default) but required on Render: a
# container filesystem is ephemeral, so a library would be lost on every deploy.
DATABASE_URL=postgresql://user:password@localhost:5432/streamify

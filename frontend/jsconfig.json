{
  "compilerOptions": {
    "baseUrl": ".",
    "module": "esnext",
    "target": "esnext",
    "paths": {
      "@/*": ["./*"]
    },
    "jsx": "react-jsx",
    "moduleResolution": "bundler"
  },
  "include": ["app/**/*.js", "app/**/*.jsx", "components/**/*.jsx", "hooks/**/*.jsx", "lib/**/*.js"],
  "exclude": ["node_modules", ".next", "public"]
}

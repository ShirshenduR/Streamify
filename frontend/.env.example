# Firebase (Google sign-in).
#
# These names are unchanged from the Vite frontend — the Next app reads them at
# runtime in /api/config, so nothing needs renaming and no rebuild is required
# when they change. Firebase web keys are public by design; they still belong to
# your project rather than to this repo, which is why this file is the template.

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional. Where the Next server proxies /api/* to. The default,
# http://127.0.0.1:8000, is where Django runs both locally and inside the Docker
# image, so you only need this if you are pointing at Django somewhere else.
# VITE_BACKEND_API_URL=http://127.0.0.1:8000
